      "name": "billing_usage",
      "item": [
        {
          "name": "Get billing usage information",
          "id": "187b743e-f74e-4b16-8369-feeba63c9a88",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/billing_usage?year=<integer>&include_prodenv_breakdown=<boolean>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "billing_usage"
              ],
              "query": [
                {
                  "description": "The year to retrieve billing usage for. Behavior depends on subscription type (see above).",
                  "key": "year",
                  "value": "<integer>"
                },
                {
                  "description": "Whether to include usage details by product environment. **Default**: false.\n",
                  "key": "include_prodenv_breakdown",
                  "value": "<boolean>"
                }
              ]
            },
            "description": "Retrieve billing usage metrics for your account and product environments,\nincluding storage, bandwidth, impressions, and transformations.\n\nIf `year` is provided:\n- **Annual subscription**: Returns the single annual usage cycle that began in the specified year (if any).\n- **Monthly subscription**: Returns all monthly usage cycles that began in the specified year.\n\nIf `year` is not provided:\n- Returns usage for the year in which the current active subscription period began.\n- If no active subscription exists, an empty list is returned.\n\n**Note**: Usage metrics are updated daily, so calling this endpoint once per day gives you the latest data."
          },
          "response": [
            {
